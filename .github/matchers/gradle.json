{
  "problemMatcher": [
    {
      "owner": "kotlin-error",
      "severity": "error",
      "pattern": [
        {
          "regexp": "^e: file://(.+?):(\\d+):(\\d+) (.+)$",
          "file": 1,
          "line": 2,
          "column": 3,
          "message": 4
        }
      ]
    },
    {
      "owner": "android-lint",
      "pattern": [
        {
          "regexp": "^(/.+?):(\\d+): (Error|Warning): (.+)$",
          "file": 1,
          "line": 2,
          "severity": 3,
          "message": 4
        }
      ]
    },
    {
      "owner": "gradle-test",
      "severity": "error",
      "pattern": [
        {
          "regexp": "^(\\S.* > .+ FAILED)$",
          "message": 1
        }
      ]
    }
  ]
}
