<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Compose draws everything; this only sets the window before the first frame. -->
    <style name="Theme.Murmur" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/day</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>

    <!-- The call window wakes the screen: start dark, like the call screen, never with a white flash. -->
    <style name="Theme.Murmur.Call">
        <item name="android:windowBackground">@color/night</item>
    </style>

    <style name="Theme.Murmur.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/night</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="postSplashScreenTheme">@style/Theme.Murmur</item>
    </style>
</resources>
